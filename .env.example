# Copy this file to .env and fill in real values. Never commit .env.

# LLM used by ai.synthesize. Default: Gemini 2.5 Flash Lite (free tier on
# Google AI Studio). Switch provider and model together.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
GOOGLE_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# Optional multi-provider failover: if set, a failed primary LLM call is
# retried against this secondary provider.
# LLM_FALLBACK_PROVIDER=anthropic
# LLM_FALLBACK_MODEL=claude-sonnet-4-6

# Web search backend for ai.fetch_web.
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# WEB_SEARCH_PROVIDER=serper
# SERPER_API_KEY=
# WEB_SEARCH_PROVIDER=duckduckgo   (no key, requires the duckduckgo-search package)

# Runtime settings. All optional, defaults shown.
LOG_LEVEL=INFO
CACHE_DIR=./.cache
CACHE_TTL_SECONDS=86400
COST_LOG_PATH=./.cache/costs.jsonl
PER_SOURCE_TIMEOUT_SECONDS=15
SYNTHESIZE_TIMEOUT_SECONDS=60
MAX_SOURCES_PER_QUERY=3
MAX_PARALLEL=3
MAX_QUESTION_LENGTH=500
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_MIN=1.0
RETRY_BACKOFF_MAX=8.0